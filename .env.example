# Copy to .env (never commit that file) and fill in. .env.local, if present, overrides .env.
# test:agent, test:ai and test:isolation read SUPABASE_URL / SUPABASE_ANON_KEY
# (falling back to the VITE_ names), SUPABASE_SERVICE_ROLE_KEY, and ANTHROPIC_API_KEY.
# They never print those values.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Only names that start with VITE_ are shipped to the browser.

# Project URL (https://<ref>.supabase.co). Public. Browser and server.
VITE_SUPABASE_URL=

# Anon / publishable key. Public. Browser and server. Not the secret key.
VITE_SUPABASE_ANON_KEY=

# Optional server alias for VITE_SUPABASE_URL. Empty means use the VITE_ value.
SUPABASE_URL=

# Optional server alias for VITE_SUPABASE_ANON_KEY. Empty means use the VITE_ value.
SUPABASE_ANON_KEY=

# Service role / secret key. Server only. Bypasses row level security. Used by the
# student link and, for stored files, for work no signed-in person does.
# Never give it a VITE_ name.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic key. Server only. Empty means drafts are labelled placeholders.
ANTHROPIC_API_KEY=

# Optional. Model for every AI feature. Empty means claude-sonnet-5-5.
ANTHROPIC_MODEL=

# Optional. Set to off to stop a declined request from re-running on a fallback model.
AI_REFUSAL_FALLBACK=

# Optional. Model used only for sorting uploaded files into folders. Empty means claude-haiku-5-5.
ANTHROPIC_SORT_MODEL=

# Assistant (POST /api/agent). Optional. Empty means 200 assistant turns per firm per UTC day.
AGENT_DAILY_LIMIT=

# Assistant tool-call rounds per request. Optional. Empty means 8.
AGENT_MAX_ROUNDS=

# Used only by `npm run import:colleges`, run by hand. Never by the browser or a server function.
SCORECARD_API_KEY=

# Comma-separated E.164 phones and emails that may receive a send. Empty means nothing sends. Server only.
SEND_ALLOWLIST=

# Which transport the dispatcher uses. Default: log (prints the body, returns log_<uuid>). Server only.
TRANSPORT=

# Email only: gmail sends email from the approving counselor's connected Gmail (they must have turned on
# sending in Firm settings). Empty or anything else keeps email on the rule above. Server only.
TRANSPORT_EMAIL=

# Public origin for student links minted at send time (e.g. http://localhost:5173). Server only.
PUBLIC_APP_URL=

# Google (Drive import and, later, sending from Gmail). Server only. All three are needed;
# with any of them empty every Google feature is hidden.
# OAuth client of type "Web application" in Google Cloud. Its redirect address is /api/google
# on the address the app runs at (http://localhost:5173/api/google in dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Google refresh tokens (AES-256-GCM) and signs the sign-in state.
# 32 random bytes as base64 or hex: `openssl rand -base64 32`. Changing it disconnects everyone.
GOOGLE_TOKEN_KEY=

# Optional. The redirect address registered with Google, when it is not /api/google on the address requests arrive at.
GOOGLE_REDIRECT_URI=

# Local work only: 1 swaps Google for a small invented Drive (server/google/fakeDrive.ts), so Connect and
# every Drive feature work with no Google account. Refused in a build and on Vercel.
GOOGLE_FAKE=

# Optional, with GOOGLE_FAKE=1: a JSON file that changes the invented Drive between syncs (see fakeDrive.ts).
GOOGLE_FAKE_STATE=

# Optional. At most this many files per sync call, to watch a long sync run in steps. Empty means time alone decides.
GOOGLE_SYNC_BATCH=
