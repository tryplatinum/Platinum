# Copy to .env.local (never commit that file) and fill in.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# ── Supabase ────────────────────────────────────────────────────────────────
# The two VITE_ values are the ONLY ones that reach the browser. They are public
# by design: row level security decides what a signed-in person can reach.

# Project URL: https://<ref>.supabase.co
VITE_SUPABASE_URL=

# The anon / publishable key (starts sb_publishable_, or a JWT with role "anon").
# NOT the secret key.
VITE_SUPABASE_ANON_KEY=

# The service role / secret key (starts sb_secret_, or a JWT with role
# "service_role"). SERVER ONLY. It bypasses row level security and is used only
# by the student link function and, for stored files, for work no signed-in
# person does. Never give it a VITE_ name and never paste it
# anywhere but here and your host's settings.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. The address students reach the app at, for the link in weekly
# texts. Leave unset in production: the app uses its own address. Links are left
# out of texts when the app is open on localhost.
# VITE_PUBLIC_URL=https://your-app.example

# ── AI ──────────────────────────────────────────────────────────────────────
# Server only. Without it the app still runs and shows labelled placeholder drafts.
ANTHROPIC_API_KEY=

# Optional. Model used for every AI feature. Default: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Set to "off" to stop the API re-running a declined request on a fallback model.
# AI_REFUSAL_FALLBACK=off

# Optional. Model used only for sorting uploaded files into folders. Default: claude-haiku-5-5
# ANTHROPIC_SORT_MODEL=claude-haiku-5-5

# ── College directory ───────────────────────────────────────────────────────
# Used only by `npm run import:colleges`, run by hand. Never by the browser or a
# server function. Free key: https://api.data.gov/signup/
SCORECARD_API_KEY=
