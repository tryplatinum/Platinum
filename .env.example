# Copy to .env.local (never commit that file) and fill in. Server-side only:
# none of these are ever sent to the browser.

# Your Anthropic API key. Without it the app still runs and shows labelled placeholder drafts.
ANTHROPIC_API_KEY=

# Shared passcode the browser must send to /api/ai. Pick any long random string.
# Counselors type it once under "AI connection" in the sidebar. Stopgap until real accounts exist.
PLATINUM_PASSCODE=

# Optional. Model used for every AI feature. Default: claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. Set to "off" to stop the API re-running a declined request on a fallback model.
# AI_REFUSAL_FALLBACK=off
