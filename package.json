{
  "name": "platinum-v0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:ai": "node --import tsx scripts/test-ai.ts",
    "test:agent": "node --import tsx scripts/test-agent.ts",
    "test:notes": "node --import tsx scripts/test-notes.ts && node --import tsx scripts/test-google.ts",
    "test:google": "node --import tsx scripts/test-google.ts",
    "test:outbox": "node --import tsx scripts/test-outbox.ts && node --import tsx scripts/test-phone.ts",
    "test:phone": "node --import tsx scripts/test-phone.ts",
    "test:phone:db": "node --env-file-if-exists=.env.local --import tsx scripts/test-phone-claim.ts",
    "test:isolation": "node --import tsx scripts/test-isolation.ts",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "import:colleges": "node --env-file-if-exists=.env.local --import tsx scripts/import-colleges.ts",
    "test:files": "node --import tsx scripts/test-files.ts",
    "test:bands": "node --import tsx scripts/test-bands.ts",
    "build:brand": "node --import tsx scripts/build-brand-assets.ts",
    "build:programs": "node --env-file-if-exists=.env.local --import tsx scripts/build-cip-programs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/functions": "^3.11.3",
    "heic-convert": "^2.1.0",
    "lucide-react": "^1.79.0",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  }
}
