{
  "name": "platinum-v0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:ai": "node --env-file-if-exists=.env.local --import tsx scripts/test-ai.ts",
    "test:isolation": "node --env-file-if-exists=.env.local --import tsx scripts/test-isolation.ts",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
